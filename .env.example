# Contact form (SPEC 03) — copy to .env.local and fill in.

# Resend API key (https://resend.com/api-keys). Required.
RESEND_API_KEY=re_xxx

# Address that receives contact messages. Required.
# With the default sender (onboarding@resend.dev) Resend only delivers to the
# email that owns the Resend account; verify a domain to send anywhere else.
CONTACT_TO_EMAIL=equipo@ejemplo.com

# Sender. Optional; defaults to "Arcade Vault <onboarding@resend.dev>".
CONTACT_FROM_EMAIL="Arcade Vault <onboarding@resend.dev>"
